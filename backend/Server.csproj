<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Authentication.JwtBearer" Version="10.0.10" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Sqlite" Version="10.0.10" />
    <PackageReference Include="SQLitePCLRaw.bundle_e_sqlite3" Version="3.0.3" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="SeedAssets/survival.boneyard"
             CopyToOutputDirectory="PreserveNewest"
             CopyToPublishDirectory="PreserveNewest" />
    <Content Include="../frontend/dist-game-host/game-session-supervisor.mjs"
             Link="GameHost/game-session-supervisor.mjs"
             CopyToOutputDirectory="PreserveNewest"
             CopyToPublishDirectory="PreserveNewest"
             Condition="Exists('../frontend/dist-game-host/game-session-supervisor.mjs')" />
    <Content Include="../frontend/dist-game-host/lua54.wasm"
             Link="GameHost/lua54.wasm"
             CopyToOutputDirectory="PreserveNewest"
             CopyToPublishDirectory="PreserveNewest"
             Condition="Exists('../frontend/dist-game-host/lua54.wasm')" />
    <Content Include="../frontend/dist-game-host/ml-bot-policy-worker.mjs"
             Link="GameHost/ml-bot-policy-worker.mjs"
             CopyToOutputDirectory="PreserveNewest"
             CopyToPublishDirectory="PreserveNewest"
             Condition="Exists('../frontend/dist-game-host/ml-bot-policy-worker.mjs')" />
    <Content Include="../frontend/dist-game-host/ml-bot-policy-v5-selected.sdml"
             Link="GameHost/ml-bot-policy-v5-selected.sdml"
             CopyToOutputDirectory="PreserveNewest"
             CopyToPublishDirectory="PreserveNewest"
             Condition="Exists('../frontend/dist-game-host/ml-bot-policy-v5-selected.sdml')" />
  </ItemGroup>

</Project>
