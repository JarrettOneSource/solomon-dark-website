{
  "name": "frontend",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "packageManager": "npm@10.9.2",
  "engines": {
    "node": "22.17.0",
    "npm": "10.9.2"
  },
  "scripts": {
    "dev": "vite",
    "build": "node tools/game-artifact.mjs check && tsc -b && vite build && node tools/game-artifact.mjs stage",
    "lint": "oxlint",
    "test": "tsc -p tsconfig.test.json --noEmit && node --experimental-strip-types --test src/editor/*.test.ts src/editor/library-ui/*.test.ts src/boneyard/*.test.ts src/lib/*.test.ts && node --experimental-strip-types --test tools/game-artifact.test.mjs tools/workshop-navigation.test.mjs",
    "preview": "vite preview",
    "smoke:library:subscriptions": "node tools/smoke-library-subscriptions.mjs",
    "smoke:workshop-storage": "node --test tools/workshop-request-store.test.mjs"
  },
  "dependencies": {
    "@fontsource/alegreya": "^5.2.8",
    "@fontsource/cinzel": "^5.2.8",
    "@fontsource/im-fell-english": "^5.2.6",
    "@fontsource/jetbrains-mono": "^5.2.8",
    "@tailwindcss/vite": "^4.3.3",
    "postcss": "8.5.23",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "react-router-dom": "7.18.2",
    "tailwindcss": "^4.3.3"
  },
  "devDependencies": {
    "@types/node": "^24.13.2",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.3",
    "oxlint": "1.74.0",
    "playwright-core": "^1.61.1",
    "typescript": "~6.0.2",
    "vite": "^8.1.1"
  }
}
