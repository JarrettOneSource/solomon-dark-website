sampler DiffuseSampler;float mSaturation : register(c0);void main(in float2 vTex : TEXCOORD0, in float4 vColor : COLOR0, out float4 oCol : COLOR0){	oCol=tex2D(DiffuseSampler, vTex);   float4 aRealCol=oCol*vColor;	float aVGrey=(vColor.r+vColor.g+vColor.b)/3;	float aGrey=(oCol.r+oCol.g+oCol.b)/3;	oCol.rgb=aVGrey * aGrey;	oCol.rgb=lerp(oCol.rgb,aRealCol.rgb,mSaturation);	oCol.a=vColor.a*oCol.a;}