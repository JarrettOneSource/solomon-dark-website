sampler2D DiffuseSampler;float mBlur : register(c0);float mTU : register(c1);float mTV : register(c2);void Blur1(in float2 vTex : TEXCOORD0, out float4 theResult : COLOR0){	theResult=0;	for (float aU=-3;aU<=2;aU++)	{		theResult+=tex2D(DiffuseSampler, float2(vTex.x+mTU*aU,vTex.y));		theResult+=tex2D(DiffuseSampler, float2(vTex.x-mTU*aU,vTex.y));		theResult+=tex2D(DiffuseSampler, float2(vTex.x,vTex.y-mTV*aU));		theResult+=tex2D(DiffuseSampler, float2(vTex.x,vTex.y+mTV*aU));	}	theResult/=20;}void main(in float2 vTex : TEXCOORD0, out float4 theResult : COLOR0){	Blur1(vTex,theResult);}