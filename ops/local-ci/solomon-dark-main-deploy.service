[Unit]
Description=Validate and deploy Solomon Dark Website main
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
ExecStart=%h/.local/libexec/solomon-dark-main-deploy
TimeoutStartSec=45min
TimeoutStopSec=30s
UMask=0077
Nice=10
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
Environment=DOTNET_CLI_TELEMETRY_OPTOUT=1
Environment=NPM_CONFIG_UPDATE_NOTIFIER=false
