solomondarker.com {
	encode zstd gzip

	header {
		Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=(), usb=()"
		Referrer-Policy "strict-origin-when-cross-origin"
		X-Content-Type-Options "nosniff"
		X-Robots-Tag "noindex, nofollow"
	}

	# Only the authoring shelf and disposable Test document may be embedded.
	@embedded path /boneyard-library /game-rust/boneyard-library /game-stg/boneyard-library /game-rust/editor-test/ /game-rust/editor-test/* /game-stg/editor-test/ /game-stg/editor-test/*
	@topLevel not path /boneyard-library /game-rust/boneyard-library /game-stg/boneyard-library /game-rust/editor-test/ /game-rust/editor-test/* /game-stg/editor-test/ /game-stg/editor-test/*
	header @embedded {
		Content-Security-Policy "default-src 'self'; base-uri 'self'; object-src 'none'; frame-ancestors 'self'; form-action 'self'; img-src 'self' data: blob:; script-src 'self' 'wasm-unsafe-eval'; style-src 'self' 'unsafe-inline'; font-src 'self' data:; connect-src 'self'; media-src 'self'; upgrade-insecure-requests"
		X-Frame-Options "SAMEORIGIN"
	}
	header @topLevel {
		Content-Security-Policy "default-src 'self'; base-uri 'self'; object-src 'none'; frame-ancestors 'none'; form-action 'self'; img-src 'self' data: blob:; script-src 'self' 'wasm-unsafe-eval'; style-src 'self' 'unsafe-inline'; font-src 'self' data:; connect-src 'self'; media-src 'self'; upgrade-insecure-requests"
		X-Frame-Options "DENY"
	}

	@assets path /assets/*
	header @assets Cache-Control "public, max-age=31536000, immutable"

	redir /game-rust /game-rust/ 308

	handle_path /game-rust/* {
		header Cache-Control "no-cache"
		@rust_api path /api/* /uploads/*
		handle @rust_api {
			reverse_proxy 127.0.0.1:5231
		}
		@rust_game path /game-hub /game-sessions/*
		handle @rust_game {
			reverse_proxy 127.0.0.1:5232
		}
		handle_path /site/* {
			root * /opt/solomon-dark-revived/RustSite
			file_server
		}
		@rust_site path /login /register /account /boneyard-library /boneyard /boneyards /mods /mods/* /parties /about /downloads /wizards/* /game
		handle @rust_site {
			root * /opt/solomon-dark-revived/RustSite
			rewrite * /index.html
			file_server
		}
		handle {
			root * /opt/solomon-dark-revived/wwwroot/game-rust
			file_server
		}
	}

	redir /game-stg /game-stg/ 308

	handle_path /game-stg/* {
		header Cache-Control "no-cache"
		@stg_embedded path /boneyard-library /editor-test/ /editor-test/*
		@stg_top_level not path /boneyard-library /editor-test/ /editor-test/*
		header @stg_embedded {
			Content-Security-Policy "default-src 'self'; base-uri 'self'; object-src 'none'; frame-ancestors 'self'; form-action 'self'; img-src 'self' data: blob:; script-src 'self' 'wasm-unsafe-eval'; style-src 'self' 'unsafe-inline'; font-src 'self' data:; connect-src 'self'; media-src 'self'; upgrade-insecure-requests"
			X-Frame-Options "SAMEORIGIN"
		}
		header @stg_top_level {
			Content-Security-Policy "default-src 'self'; base-uri 'self'; object-src 'none'; frame-ancestors 'none'; form-action 'self'; img-src 'self' data: blob:; script-src 'self' 'wasm-unsafe-eval'; style-src 'self' 'unsafe-inline'; font-src 'self' data:; connect-src 'self'; media-src 'self'; upgrade-insecure-requests"
			X-Frame-Options "DENY"
		}

		@stg_api path /api/* /uploads/*
		handle @stg_api {
			reverse_proxy 127.0.0.1:5229
		}
		@stg_game path /game-hub /game-sessions/*
		handle @stg_game {
			reverse_proxy 127.0.0.1:5230
		}
		handle_path /site/* {
			root * /opt/solomon-rust-stg/current/site
			file_server
		}
		@stg_site path /login /register /account /boneyard-library /boneyard /boneyards /mods /mods/* /parties /about /downloads /wizards/* /game
		handle @stg_site {
			root * /opt/solomon-rust-stg/current/site
			rewrite * /index.html
			file_server
		}
		handle {
			root * /opt/solomon-rust-stg/current/web
			file_server
		}
	}

	handle /game-hub {
		reverse_proxy 127.0.0.1:5222
	}

	handle /game-sessions/* {
		reverse_proxy 127.0.0.1:5222
	}

	handle {
		reverse_proxy 127.0.0.1:5220
	}
}

www.solomondarker.com {
	redir https://solomondarker.com{uri} permanent
}

solomon.genericproject.xyz {
	handle /api/* {
		reverse_proxy 127.0.0.1:5220
	}

	handle {
		redir https://solomondarker.com{uri} permanent
	}
}
